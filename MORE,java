package com.example.refinitivtreasury.repository;

import com.example.refinitivtreasury.dto.TreasuryPriceDto;
import javax.persistence.EntityManager;
import javax.persistence.PersistenceContext;
import oracle.jdbc.OracleConnection;
import oracle.sql.ARRAY;
import oracle.sql.ArrayDescriptor;
import oracle.sql.STRUCT;
import oracle.sql.StructDescriptor;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.retry.annotation.Backoff;
import org.springframework.retry.annotation.Retryable;
import org.springframework.stereotype.Repository;
import org.springframework.transaction.annotation.Transactional;

import java.sql.SQLException;
import java.sql.Timestamp;
import java.util.List;

@Repository
public class TreasuryDataRepository {

    private static final Logger logger = LoggerFactory.getLogger(TreasuryDataRepository.class);

    @PersistenceContext
    private EntityManager entityManager;

    @Retryable(
        value = { SQLException.class },
        maxAttempts = 3,
        backoff = @Backoff(delay = 500, maxDelay = 2000, multiplier = 2)
    )
    @Transactional
    public void upsert(List<TreasuryPriceDto> prices) {
        logger.info("Attempting to upsert {} TreasuryPriceDto records", prices.size());
        try {
            OracleConnection oracleConnection = entityManager.unwrap(OracleConnection.class);
            StructDescriptor structDescriptor = StructDescriptor.createDescriptor("TREASURY_PRICE_T", oracleConnection);
            ArrayDescriptor arrayDescriptor = ArrayDescriptor.createDescriptor("TREASURY_PRICE_TAB", oracleConnection);

            STRUCT[] structs = new STRUCT[prices.size()];
            for (int i = 0; i < prices.size(); i++) {
                TreasuryPriceDto price = prices.get(i);
                Object[] fields = new Object[]{
                    price.getRic(),
                    price.getTimestamp() != null ? Timestamp.valueOf(price.getTimestamp()) : null,
                    price.getBidYield(),
                    price.getAskYield(),
                    price.getBidPrice(),
                    price.getAskPrice(),
                    price.getUpdateType(),
                    price.getLastUpdate() != null ? Timestamp.valueOf(price.getLastUpdate()) : null
                };
                structs[i] = new STRUCT(structDescriptor, oracleConnection, fields);
            }
            ARRAY array = new ARRAY(arrayDescriptor, oracleConnection, structs);

            String sql = "{call treasury_feeds.load_treasury_prices(?)}";
            javax.persistence.StoredProcedureQuery query = entityManager
                .createStoredProcedureQuery(sql)
                .registerStoredProcedureParameter(1, Object.class, javax.persistence.ParameterMode.IN)
                .setParameter(1, array);
            query.execute();
            logger.info("Successfully upserted {} records to Treasury_data", prices.size());
        } catch (SQLException e) {
            logger.error("Failed to upsert {} records: error_code={}, sql_state={}", 
                prices.size(), e.getErrorCode(), e.getSQLState(), e);
            throw new RuntimeException("Failed to call stored procedure", e);
        }
    }

    public void upsertFallback(List<TreasuryPriceDto> prices, Exception e) {
        logger.error("Failed to upsert {} records after retries: error={}", prices.size(), e.getMessage());
        // Optionally save to a file or queue for later processing
    }
}

/* RefinitivOmmConsumer.java */
package com.example.refinitivtreasury.service;

import com.example.refinitivtreasury.dto.TreasuryPriceDto;
import com.refinitiv.ema.access.*;
import io.micrometer.core.instrument.MeterRegistry;
import io.micrometer.core.instrument.Counter;
import io.micrometer.core.instrument.Timer;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.core.env.Environment;
import org.springframework.core.io.Resource;
import org.springframework.core.io.ResourceLoader;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import javax.annotation.PostConstruct;
import java.io.IOException;
import java.nio.file.Files;
import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;
import java.util.Set;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.ArrayBlockingQueue;
import java.util.concurrent.BlockingQueue;
import java.util.concurrent.TimeUnit;

@Component
public class RefinitivOmmConsumer implements OmmConsumerClient {

    private static final Logger logger = LoggerFactory.getLogger(RefinitivOmmConsumer.class);
    private static final int QUEUE_CAPACITY = 10000;
    private static final int RECONNECT_INTERVAL_MS = 5000;
    private static final int DISPATCH_TIMEOUT_US = 1000; // 1ms

    private OmmConsumer consumer;
    private final BlockingQueue<TreasuryPriceDto> messageQueue = new ArrayBlockingQueue<>(QUEUE_CAPACITY);
    private final List<Long> itemHandles = new ArrayList<>();
    private final Set<String> subscribedRics = ConcurrentHashMap.newKeySet();
    private final Counter droppedMessagesCounter;
    private final Counter dispatchedMessagesCounter;
    private final Counter subscriptionCounter;
    private final Timer offerLatencyTimer;
    private final Timer pollLatencyTimer;

    @Autowired
    private MeterRegistry meterRegistry;

    @Autowired
    private ResourceLoader resourceLoader;

    @Autowired
    private Environment environment;

    public RefinitivOmmConsumer(MeterRegistry meterRegistry, ResourceLoader resourceLoader, Environment environment) {
        this.meterRegistry = meterRegistry;
        this.resourceLoader = resourceLoader;
        this.environment = environment;
        this.droppedMessagesCounter = Counter.builder("queue.dropped.messages")
            .description("Number of messages dropped due to queue being full")
            .register(meterRegistry);
        this.dispatchedMessagesCounter = Counter.builder("consumer.dispatched.messages")
            .description("Number of messages dispatched by OmmConsumer")
            .register(meterRegistry);
        this.subscriptionCounter = Counter.builder("consumer.subscriptions")
            .description("Number of active subscriptions")
            .register(meterRegistry);
        this.offerLatencyTimer = Timer.builder("queue.offer.latency")
            .description("Latency of offer operations to message queue")
            .publishPercentiles(0.5, 0.95, 0.99)
            .register(meterRegistry);
        this.pollLatencyTimer = Timer.builder("queue.poll.latency")
            .description("Latency of poll operations from message queue")
            .publishPercentiles(0.5, 0.95, 0.99)
            .register(meterRegistry);
        Gauge.builder("message.queue.size", messageQueue, BlockingQueue::size)
            .description("Size of the TreasuryPriceDto message queue")
            .register(meterRegistry);
        Gauge.builder("consumer.subscriptions.active", subscribedRics, Set::size)
            .description("Number of active RICs subscribed")
            .register(meterRegistry);
    }

    @PostConstruct
    public void initialize() {
        int attempts = 0;
        while (consumer == null && attempts < 3) {
            try {
                // Load EmaConfig.xml from resources
                Resource resource = resourceLoader.getResource("classpath:EmaConfig.xml");
                if (!resource.exists()) {
                    logger.error("EmaConfig.xml not found in resources");
                    throw new RuntimeException("EmaConfig.xml not found");
                }
                String configXml = new String(Files.readAllBytes(resource.getFile().toPath()));
                logger.debug("Loaded EmaConfig.xml: {}", configXml);

                // Validate and replace host and port from application.properties
                String host = environment.getProperty("refinitiv.host");
                String port = environment.getProperty("refinitiv.port");
                if (host == null || port == null) {
                    logger.error("refinitiv.host or refinitiv.port not set in application.properties");
                    throw new RuntimeException("Missing refinitiv.host or refinitiv.port");
                }
                // Replace placeholders in EmaConfig.xml
                configXml = configXml.replace("${refinitiv.host}", host)
                                    .replace("${refinitiv.port}", port);
                logger.debug("Processed EmaConfig.xml with host={} and port={}", host, port);

                // Initialize OmmConsumer with modified EmaConfig.xml
                OmmConsumerConfig config = EmaFactory.createOmmConsumerConfig();
                config.config(EmaFactory.createDataBuffer(configXml.getBytes()));
                consumer = EmaFactory.createOmmConsumer(config);
                logger.info("OmmConsumer initialized successfully, host={}, port={}", host, port);
            } catch (IOException | OmmException e) {
                attempts++;
                logger.error("Failed to initialize OmmConsumer, attempt={}/3, error={}", attempts, e.getMessage(), e);
                if (attempts < 3) {
                    try {
                        Thread.sleep(RECONNECT_INTERVAL_MS);
                    } catch (InterruptedException ie) {
                        Thread.currentThread().interrupt();
                        logger.warn("Interrupted during reconnect delay");
                    }
                }
            }
        }
        if (consumer == null) {
            logger.error("OmmConsumer initialization failed after 3 attempts");
            throw new RuntimeException("Failed to initialize OmmConsumer after 3 attempts");
        }
    }

    @Scheduled(fixedRate = 1) // Run every 1ms
    public void dispatchEvents() {
        try {
            if (consumer != null) {
                consumer.dispatch(DISPATCH_TIMEOUT_US); // Dispatch events with 1ms timeout
                dispatchedMessagesCounter.increment();
                logger.debug("Dispatched events, queue_size={}", messageQueue.size());
            } else {
                logger.warn("OmmConsumer not initialized, skipping dispatch");
            }
        } catch (OmmException e) {
            logger.error("Failed to dispatch events, error_code={}", e.getErrorCode(), e);
        }
    }

    public void subscribeToChain(String chainRic) {
        try {
            if (subscribedRics.add(chainRic)) {
                long handle = consumer.registerClient(
                        EmaFactory.createReqMsg().serviceName("ELEKTRON_DD").name(chainRic), this);
                itemHandles.add(handle);
                subscriptionCounter.increment();
                logger.info("Subscribed to chain, ric={}, handle={}, active_subscriptions={}", 
                    chainRic, handle, subscribedRics.size());
            } else {
                logger.debug("Already subscribed to chain, ric={}", chainRic);
            }
        } catch (OmmException e) {
            logger.error("Failed to subscribe to chain, ric={}, error_code={}", chainRic, e.getErrorCode(), e);
            subscribedRics.remove(chainRic);
        }
    }

    public void unsubscribeAll() {
        for (Long handle : itemHandles) {
            try {
                consumer.unregister(handle);
                subscriptionCounter.increment(-1);
                logger.info("Unsubscribed handle={}", handle);
            } catch (OmmException e) {
                logger.error("Failed to unsubscribe, handle={}, error_code={}", handle, e.getErrorCode(), e);
            }
        }
        itemHandles.clear();
        subscribedRics.clear();
        logger.info("Unsubscribed all handles, total={}", itemHandles.size());
    }

    public void shutdown() {
        if (consumer != null) {
            try {
                consumer.uninitialize();
                logger.info("OmmConsumer shutdown successfully");
            } catch (OmmException e) {
                logger.error("Failed to shutdown OmmConsumer, error_code={}", e.getErrorCode(), e);
            }
        }
    }

    @Override
    public void onRefreshMsg(RefreshMsg refreshMsg, OmmConsumerEvent event) {
        logger.info("Received refresh message, ric={}, domain={}", refreshMsg.name(), refreshMsg.domainType());
        processMessage(refreshMsg, "REFRESH");
    }

    @Override
    public void onUpdateMsg(UpdateMsg updateMsg, OmmConsumerEvent event) {
        logger.info("Received update message, ric={}, domain={}", updateMsg.name(), updateMsg.domainType());
        processMessage(updateMsg, "UPDATE");
    }

    @Override
    public void onStatusMsg(StatusMsg statusMsg, OmmConsumerEvent event) {
        logger.info("Received status message, ric={}, state={}, stream_state={}, data_state={}", 
            statusMsg.name(), statusMsg.state(), statusMsg.state().streamState(), statusMsg.state().dataState());
    }

    private void processMessage(Msg msg, String updateType) {
        try {
            if (msg.domainType() == EmaRdm.MMT_MARKET_PRICE) {
                processMarketPrice(msg, updateType);
            } else if (msg.domainType() == EmaRdm.MMT_MARKET_BY_PRICE) {
                processChain(msg);
            } else {
                logger.debug("Ignored message, ric={}, domain={}", msg.name(), msg.domainType());
            }
        } catch (Exception e) {
            logger.error("Error processing message, ric={}, update_type={}, error={}", 
                msg.name(), updateType, e.getMessage(), e);
        }
    }

    private void processMarketPrice(Msg msg, String updateType) {
        TreasuryPriceDto dto = new TreasuryPriceDto();
        dto.setRic(msg.name());
        dto.setTimestamp(LocalDateTime.now());
        dto.setUpdateType(updateType);
        dto.setLastUpdate(LocalDateTime.now());

        FieldList fieldList = msg.payload().fieldList();
        for (FieldEntry entry : fieldList) {
            switch (entry.fieldId()) {
                case 22: // BID
                    dto.setBidPrice(entry.doubleValue());
                    logger.debug("Processed field, ric={}, field_id=22, bid_price={}", msg.name(), entry.doubleValue());
                    break;
                case 25: // ASK
                    dto.setAskPrice(entry.doubleValue());
                    logger.debug("Processed field, ric={}, field_id=25, ask_price={}", msg.name(), entry.doubleValue());
                    break;
                case 393: // YLD_1 (Bid Yield)
                    dto.setBidYield(entry.doubleValue());
                    logger.debug("Processed field, ric={}, field_id=393, bid_yield={}", msg.name(), entry.doubleValue());
                    break;
                case 396: // ASK_YLD
                    dto.setAskYield(entry.doubleValue());
                    logger.debug("Processed field, ric={}, field_id=396, ask_yield={}", msg.name(), entry.doubleValue());
                    break;
            }
        }

        if (dto.getRic() != null && !dto.getRic().isEmpty()) {
            long startTime = System.nanoTime();
            if (!messageQueue.offer(dto)) {
                droppedMessagesCounter.increment();
                logger.warn("Message queue full, dropping message, ric={}", dto.getRic());
            } else {
                offerLatencyTimer.record(System.nanoTime() - startTime, TimeUnit.NANOSECONDS);
                logger.debug("Queued TreasuryPriceDto, ric={}, queue_size={}", dto.getRic(), messageQueue.size());
            }
        } else {
            logger.warn("Invalid RIC in message, ric={}", msg.name());
        }
    }

    private void processChain(Msg msg) {
        if (msg.payload().map() != null) {
            Map map = msg.payload().map();
            int count = 0;
            for (MapEntry entry : map) {
                if (entry.key().dataType() == DataType.DataTypes.ASCII) {
                    String ric = entry.key().ascii();
                    if (subscribedRics.add(ric)) {
                        try {
                            long handle = consumer.registerClient(
                                    EmaFactory.createReqMsg().serviceName("ELEKTRON_DD").name(ric), this);
                            itemHandles.add(handle);
                            subscriptionCounter.increment();
                            logger.info("Subscribed to chain constituent, ric={}, handle={}, active_subscriptions={}", 
                                ric, handle, subscribedRics.size());
                            count++;
                        } catch (OmmException e) {
                            logger.error("Failed to subscribe to chain constituent, ric={}, error_code={}", 
                                ric, e.getErrorCode(), e);
                            subscribedRics.remove(ric);
                        }
                    }
                }
            }
            logger.info("Processed chain, ric={}, new_subscriptions={}", msg.name(), count);
        }
    }

    public TreasuryPriceDto pollMessage() {
        long startTime = System.nanoTime();
        TreasuryPriceDto dto = messageQueue.poll();
        if (dto != null) {
            pollLatencyTimer.record(System.nanoTime() - startTime, TimeUnit.NANOSECONDS);
            logger.debug("Polled message, ric={}, queue_size={}", dto.getRic(), messageQueue.size());
        }
        return dto;
    }

    public int messageQueueSize() {
        return messageQueue.size();
    }

    public int getActiveSubscriptions() {
        return subscribedRics.size();
    }
}

