package com.example.refinitivtreasury.service;

import com.example.refinitivtreasury.dto.TreasuryPriceDto;
import com.example.refinitivtreasury.repository.TreasuryDataRepository;
import io.micrometer.core.instrument.MeterRegistry;
import io.micrometer.core.instrument.Gauge;
import io.micrometer.core.instrument.Counter;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RestController;

import javax.annotation.PostConstruct;
import javax.annotation.PreDestroy;
import java.time.LocalDateTime;
import java.time.LocalTime;
import java.time.ZoneId;
import java.time.DayOfWeek;
import java.util.ArrayList;
import java.util.List;

@Service
@RestController
public class TreasuryDataService {

    private static final Logger logger = LoggerFactory.getLogger(TreasuryDataService.class);

    @Autowired
    private RefinitivOmmConsumer ommConsumer;

    @Autowired
    private TreasuryDataRepository repository;

    @Autowired
    private LeaderElectionService leaderElectionService;

    @Autowired
    private MeterRegistry meterRegistry;

    private final List<TreasuryPriceDto> batch = new ArrayList<>();
    private static final int BATCH_SIZE = 1000;
    private final Counter startConsumerCounter;
    private final Counter stopConsumerCounter;
    private final Counter processMessagesCounter;
    private final Counter flushBatchCounter;
    private final Counter testSchedulerCounter;

    public TreasuryDataService(MeterRegistry meterRegistry) {
        this.meterRegistry = meterRegistry;
        this.startConsumerCounter = Counter.builder("scheduled.task.invocations")
            .tag("method", "startConsumer")
            .description("Invocations of startConsumer scheduled task")
            .register(meterRegistry);
        this.stopConsumerCounter = Counter.builder("scheduled.task.invocations")
            .tag("method", "stopConsumer")
            .description("Invocations of stopConsumer scheduled task")
            .register(meterRegistry);
        this.processMessagesCounter = Counter.builder("scheduled.task.invocations")
            .tag("method", "processMessages")
            .description("Invocations of processMessages scheduled task")
            .register(meterRegistry);
        this.flushBatchCounter = Counter.builder("scheduled.task.invocations")
            .tag("method", "flushBatch")
            .description("Invocations of flushBatch scheduled task")
            .register(meterRegistry);
        this.testSchedulerCounter = Counter.builder("scheduled.task.invocations")
            .tag("method", "testScheduler")
            .description("Invocations of testScheduler task")
            .register(meterRegistry);
    }

    @PostConstruct
    public void init() {
        ommConsumer.initialize();
        Gauge.builder("message.batch.size", batch, List::size)
             .description("Size of the TreasuryPriceDto batch queue")
             .register(meterRegistry);
        logger.info("TreasuryDataService initialized, batch_size_limit={}", BATCH_SIZE);
        // Subscribe at startup if within operating hours and leader
        boolean isOperating = isWithinOperatingHours();
        boolean isLeader = leaderElectionService.isLeader();
        if (isOperating && isLeader) {
            ommConsumer.subscribeToChain("0#USTSY=");
            logger.info("Subscribed to chain 0#USTSY= at startup, active_subscriptions={}", 
                ommConsumer.getActiveSubscriptions());
        } else {
            logger.warn("Skipped startup subscription, is_leader={}, is_operating={}, time={}, day={}", 
                isLeader, isOperating, LocalDateTime.now(ZoneId.of("Asia/Kolkata")), 
                LocalDateTime.now(ZoneId.of("Asia/Kolkata")).getDayOfWeek());
        }
    }

    @PreDestroy
    public void destroy() {
        ommConsumer.shutdown();
        logger.info("TreasuryDataService shutdown");
    }

    private boolean isWithinOperatingHours() {
        LocalDateTime now = LocalDateTime.now(ZoneId.of("Asia/Kolkata"));
        LocalTime time = now.toLocalTime();
        DayOfWeek day = now.getDayOfWeek();
        boolean isOperating = day != DayOfWeek.SATURDAY && day != DayOfWeek.SUNDAY &&
               time.isAfter(LocalTime.of(3, 0)) && time.isBefore(LocalTime.of(23, 0));
        logger.debug("Checked operating hours, time={}, day={}, is_operating={}", time, day, isOperating);
        return isOperating;
    }

    @Scheduled(cron = "0 * 3-22 * * MON-FRI") // Every minute from 3 AM to 10 PM IST
    public void startConsumer() {
        startConsumerCounter.increment();
        logger.info("startConsumer scheduled task invoked, time={}", 
            LocalDateTime.now(ZoneId.of("Asia/Kolkata")));
        boolean isOperating = isWithinOperatingHours();
        boolean isLeader = leaderElectionService.isLeader();
        if (isOperating && isLeader) {
            ommConsumer.subscribeToChain("0#USTSY=");
            logger.info("Started consumer for chain 0#USTSY=, active_subscriptions={}", 
                ommConsumer.getActiveSubscriptions());
        } else {
            logger.debug("Skipped starting consumer, is_leader={}, is_operating={}, time={}, day={}", 
                isLeader, isOperating, LocalDateTime.now(ZoneId.of("Asia/Kolkata")), 
                LocalDateTime.now(ZoneId.of("Asia/Kolkata")).getDayOfWeek());
        }
    }

    @Scheduled(cron = "0 0 23 * * MON-FRI")
    public void stopConsumer() {
        stopConsumerCounter.increment();
        logger.info("stopConsumer scheduled task invoked, time={}", 
            LocalDateTime.now(ZoneId.of("Asia/Kolkata")));
        if (leaderElectionService.isLeader()) {
            ommConsumer.unsubscribeAll();
            logger.info("Stopped consumer, active_subscriptions={}", ommConsumer.getActiveSubscriptions());
        } else {
            logger.debug("Skipped stopping consumer, is_leader={}", leaderElectionService.isLeader());
        }
    }

    @Scheduled(fixedRate = 1000)
    @Transactional
    public void processMessages() {
        processMessagesCounter.increment();
        logger.info("processMessages scheduled task invoked, is_leader={}, is_operating={}, queue_size={}", 
            leaderElectionService.isLeader(), isWithinOperatingHours(), ommConsumer.messageQueueSize());
        if (!isWithinOperatingHours() || !leaderElectionService.isLeader()) {
            logger.debug("Skipped message processing, is_leader={}, is_operating={}, queue_size={}", 
                leaderElectionService.isLeader(), isWithinOperatingHours(), ommConsumer.messageQueueSize());
            return;
        }

        long startTime = System.currentTimeMillis();
        int processed = 0;
        TreasuryPriceDto dto;
        while ((dto = ommConsumer.pollMessage()) != null) {
            batch.add(dto);
            processed++;
            if (batch.size() >= BATCH_SIZE) {
                repository.upsert(new ArrayList<>(batch));
                logger.info("Processed batch, size={}, duration_ms={}", 
                    batch.size(), System.currentTimeMillis() - startTime);
                batch.clear();
            }
        }
        logger.debug("Processed {} messages, batch_size={}, queue_size={}, duration_ms={}", 
            processed, batch.size(), ommConsumer.messageQueueSize(), System.currentTimeMillis() - startTime);
    }

    @Scheduled(fixedRate = 25000)
    @Transactional
    public void flushBatch() {
        flushBatchCounter.increment();
        logger.info("flushBatch scheduled task invoked, is_leader={}, is_operating={}, batch_size={}", 
            leaderElectionService.isLeader(), isWithinOperatingHours(), batch.size());
        if (!isWithinOperatingHours() || !leaderElectionService.isLeader() || batch.isEmpty()) {
            logger.debug("Skipped batch flush, is_leader={}, is_operating={}, batch_size={}, queue_size={}", 
                leaderElectionService.isLeader(), isWithinOperatingHours(), batch.size(), ommConsumer.messageQueueSize());
            return;
        }
        long startTime = System.currentTimeMillis();
        repository.upsert(new ArrayList<>(batch));
        logger.info("Flushed batch, size={}, duration_ms={}", 
            batch.size(), System.currentTimeMillis() - startTime);
        batch.clear();
    }

    @Scheduled(fixedRate = 5000)
    public void testScheduler() {
        testSchedulerCounter.increment();
        logger.info("testScheduler invoked, time={}", LocalDateTime.now(ZoneId.of("Asia/Kolkata")));
    }

    @PostMapping("/trigger-process-messages")
    public String triggerProcessMessages() {
        processMessages();
        return "processMessages triggered";
    }

    @PostMapping("/trigger-flush-batch")
    public String triggerFlushBatch() {
        flushBatch();
        return "flushBatch triggered";
    }

    @PostMapping("/trigger-start-consumer")
    public String triggerStartConsumer() {
        startConsumer();
        return "startConsumer triggered";
    }
}

