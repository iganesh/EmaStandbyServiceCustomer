package com.example.refinitivtreasury.config;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.context.annotation.Configuration;
import org.springframework.scheduling.annotation.SchedulingConfigurer;
import org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler;
import org.springframework.scheduling.config.ScheduledTaskRegistrar;
import org.springframework.scheduling.support.ScheduledMethodRunnable;

@Configuration
public class ThreadPoolConfig implements SchedulingConfigurer {

    private static final Logger logger = LoggerFactory.getLogger(ThreadPoolConfig.class);

    @Override
    public void configureTasks(ScheduledTaskRegistrar taskRegistrar) {
        ThreadPoolTaskScheduler scheduler = new ThreadPoolTaskScheduler();
        scheduler.setPoolSize(6);
        scheduler.setThreadNamePrefix("MessageProcessor-");
        scheduler.initialize();
        taskRegistrar.setTaskScheduler(scheduler);
        taskRegistrar.afterPropertiesSet();
        // Log scheduled tasks
        for (Object task : taskRegistrar.getScheduledTasks()) {
            if (task instanceof ScheduledMethodRunnable) {
                ScheduledMethodRunnable runnable = (ScheduledMethodRunnable) task;
                logger.info("Registered scheduled task: method={}, target={}", 
                    runnable.getMethod().getName(), runnable.getTarget().getClass().getSimpleName());
            }
        }
        logger.info("Total scheduled tasks: {}", taskRegistrar.getScheduledTasks().size());
    }
}

