package com.example.refinitivtreasury.service;

import org.apache.curator.RetryPolicy;
import org.apache.curator.framework.CuratorFramework;
import org.apache.curator.framework.CuratorFrameworkFactory;
import org.apache.curator.framework.recipes.leader.LeaderLatch;
import org.apache.curator.framework.state.ConnectionState;
import org.apache.curator.framework.state.ConnectionStateListener;
import org.apache.curator.retry.ExponentialBackoffRetry;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

import javax.annotation.PostConstruct;
import javax.annotation.PreDestroy;
import java.util.UUID;

@Service
@RestController
public class LeaderElectionService {

    private static final Logger logger = LoggerFactory.getLogger(LeaderElectionService.class);
    private static final String ZK_CONNECTION_STRING = "localhost:2181";
    private static final String LEADER_PATH = "/refinitiv/leader";
    private final CuratorFramework client;
    private final LeaderLatch leaderLatch;
    private final String nodeId;

    public LeaderElectionService() {
        this.nodeId = UUID.randomUUID().toString();
        RetryPolicy retryPolicy = new ExponentialBackoffRetry(1000, 3);
        this.client = CuratorFrameworkFactory.newClient(ZK_CONNECTION_STRING, retryPolicy);
        this.leaderLatch = new LeaderLatch(client, LEADER_PATH, nodeId);
        this.client.getConnectionStateListenable().addListener(new ConnectionStateListener() {
            @Override
            public void stateChanged(CuratorFramework client, ConnectionState newState) {
                logger.info("ZooKeeper connection state changed, node_id={}, state={}", nodeId, newState);
                if (newState == ConnectionState.LOST || newState == ConnectionState.SUSPENDED) {
                    logger.warn("ZooKeeper connection issue detected, node_id={}, state={}", nodeId, newState);
                }
            }
        });
    }

    @PostConstruct
    public void init() {
        try {
            client.start();
            leaderLatch.start();
            logger.info("Leader election initialized, node_id={}, zk_connect={}", nodeId, ZK_CONNECTION_STRING);
            logger.info("Initial leadership status, node_id={}, is_leader={}", nodeId, leaderLatch.hasLeadership());
        } catch (Exception e) {
            logger.error("Failed to initialize leader election, node_id={}, error={}", nodeId, e.getMessage(), e);
            throw new RuntimeException("Leader election initialization failed", e);
        }
    }

    @PreDestroy
    public void destroy() {
        try {
            leaderLatch.close();
            client.close();
            logger.info("Leader election shutdown, node_id={}", nodeId);
        } catch (Exception e) {
            logger.error("Failed to shutdown leader election, node_id={}, error={}", nodeId, e);
        }
    }

    public boolean isLeader() {
        boolean isLeader = leaderLatch.hasLeadership();
        logger.debug("Checked leadership status, node_id={}, is_leader={}", nodeId, isLeader);
        return isLeader;
    }

    @Scheduled(fixedRate = 5000) // Reduced to 5s for frequent checks
    public void logLeadershipStatus() {
        try {
            logger.info("Periodic leadership check, node_id={}, is_leader={}, participants={}", 
                nodeId, leaderLatch.hasLeadership(), leaderLatch.getParticipants().size());
        } catch (Exception e) {
            logger.error("Failed to check leadership status, node_id={}, error={}", nodeId, e.getMessage());
        }
    }

    @GetMapping("/leadership-status")
    public String getLeadershipStatus() {
        boolean isLeader = leaderLatch.hasLeadership();
        return String.format("Node ID: %s, Is Leader: %s, Participants: %d", 
            nodeId, isLeader, leaderLatch.getParticipants().size());
    }
}

